# Sika Threads Environment Variables Example
# Official Tagline: Weaving Heritage, Stitching Modernity.

# Frontend Firebase Client Configuration (Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Server-Side Configuration (NEVER expose to frontend code)
PORT=5000
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
EMAIL_PROVIDER=resend # or sendgrid
EMAIL_API_KEY=your_transactional_email_provider_key
EMAIL_FROM="Sika Threads <orders@sikathreads.com.gh>"
ADMIN_NOTIFICATION_EMAIL=orders@sikathreads.com.gh
