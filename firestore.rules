rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: Public can read published items; Only Admin can write
    match /products/{productId} {
      allow read: if resource.data.publicationStatus == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Categories & Collections: Public read; Admin write
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Orders: Customers can read and create their own order requests; Admin can read and update all
    match /orders/{orderId} {
      allow create: if true; // Allows guest checkout with backend validation
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // StyleMatch Requests: Customer can create and read own; Admin can manage
    match /stylematch_requests/{requestId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Sourcing Requests: Customer create; Admin manage
    match /sourcing_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact Enquiries: Public create; Admin read/manage
    match /contact_enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Stock Movements & Audit Logs: strictly Admin or trusted server
    match /stock_movements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Site Content & Settings: Public read; Admin write
    match /site_content/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: Customer can read/write own profile (cannot alter role); Admin can read/write all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
